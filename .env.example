PORT=5000
NODE_ENV=production

# MongoDB
MONGO_URI=mongodb+srv://<user>:<password>@cluster.mongodb.net/cafe_delivery

# JWT
JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRES_IN=7d

# Paymob
PAYMOB_API_KEY=your_paymob_api_key
PAYMOB_INTEGRATION_ID_CARD=your_card_integration_id
PAYMOB_IFRAME_ID=your_iframe_id
PAYMOB_HMAC_SECRET=your_hmac_secret

# CORS
ALLOWED_ORIGINS=http://localhost:19006

# WhatsApp Cloud API - OTP / verification
# Create an approved Authentication template in Meta WhatsApp Manager.
WHATSAPP_GRAPH_VERSION=v23.0
WHATSAPP_PHONE_NUMBER_ID=your_meta_phone_number_id
WHATSAPP_ACCESS_TOKEN=your_permanent_meta_access_token
WHATSAPP_OTP_TEMPLATE=dozo_login_code
WHATSAPP_RESET_TEMPLATE=dozo_reset_code
WHATSAPP_OTP_LANGUAGE=ar
WHATSAPP_OTP_BUTTON=true

# Google OAuth client IDs. Add the clients you actually use.
GOOGLE_ANDROID_CLIENT_ID=your_android_google_client_id.apps.googleusercontent.com
GOOGLE_IOS_CLIENT_ID=your_ios_google_client_id.apps.googleusercontent.com
GOOGLE_WEB_CLIENT_ID=your_web_google_client_id.apps.googleusercontent.com

# Cloudinary - delivery confirmation photos
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
