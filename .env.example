PORT=5000
NODE_ENV=production

# MongoDB
MONGO_URI=mongodb+srv://<user>:<password>@cluster.mongodb.net/cafe_delivery

# JWT
JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRES_IN=7d

# Paymob (get these from your Paymob dashboard)
PAYMOB_API_KEY=your_paymob_api_key
PAYMOB_INTEGRATION_ID_CARD=your_card_integration_id
PAYMOB_IFRAME_ID=your_iframe_id
PAYMOB_HMAC_SECRET=your_hmac_secret

# CORS - comma separated allowed origins
ALLOWED_ORIGINS=http://localhost:19006

# SMS / OTP provider - choose one: "twilio", "generic_http", or leave unset for dev (logs OTP to console)
SMS_PROVIDER=twilio
# Twilio
TWILIO_SID=your_twilio_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_FROM_NUMBER=+1xxxxxxxxxx
# Generic HTTP provider (e.g. a local Egyptian SMS gateway)
SMS_PROVIDER_URL=https://your-sms-provider.com/api/send
SMS_PROVIDER_KEY=your_provider_api_key

# Cloudinary - used for delivery-confirmation photo uploads (free tier is enough to start)
# Get these from https://console.cloudinary.com/console (dashboard, after signup)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
